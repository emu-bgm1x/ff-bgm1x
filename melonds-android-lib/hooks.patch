diff --git a/src/SPU.cpp b/src/SPU.cpp
index f42beee..76da134 100644
--- a/src/SPU.cpp
+++ b/src/SPU.cpp
@@ -335,7 +335,9 @@ void SPU::SetDegrade10Bit(AudioBitDepth depth)
     switch (depth)
     {
     case AudioBitDepth::Auto:
-        Degrade10Bit = (NDS.ConsoleType == 0);
+        // ff-bgm1x: 처음 켤 때(생성자)는 항상 16비트로 시작하는데, 롬을 다시 불러오면 이 함수가 불려
+        // DS 에서는 10비트로 바뀌었다. 같은 설정에서 소리가 달라지지 않게 자동은 16비트로 맞춘다
+        Degrade10Bit = false;
         break;
     case AudioBitDepth::_10Bit:
         Degrade10Bit = true;
@@ -861,6 +863,20 @@ void SPU::Mix(u32 spucycles)
         s32 ch1 = Channels[1].DoRun(spucycles);
         s32 ch2 = Channels[2].DoRun(spucycles);
         s32 ch3 = Channels[3].DoRun(spucycles);
+        if (FfbgmMuteMask)  // ff-bgm1x
+        {
+            if (FfbgmMuteMask & 1) ch0 = 0;
+            if (FfbgmMuteMask & 2) ch1 = 0;
+            if (FfbgmMuteMask & 4) ch2 = 0;
+            if (FfbgmMuteMask & 8) ch3 = 0;
+        }
+        if (FfbgmGainMask)  // ff-bgm1x
+        {
+            if (FfbgmGainMask & 1) ch0 = (ch0 * FfbgmGainQ8) >> 8;
+            if (FfbgmGainMask & 2) ch1 = (ch1 * FfbgmGainQ8) >> 8;
+            if (FfbgmGainMask & 4) ch2 = (ch2 * FfbgmGainQ8) >> 8;
+            if (FfbgmGainMask & 8) ch3 = (ch3 * FfbgmGainQ8) >> 8;
+        }
 
         // TODO: addition from capture registers
         Channels[0].PanOutput(ch0, left, right);
@@ -874,6 +890,8 @@ void SPU::Mix(u32 spucycles)
             SPUChannel* chan = &Channels[i];
 
             s32 channel = chan->DoRun(spucycles);
+            if (FfbgmMuteMask & (1 << i)) channel = 0;  // ff-bgm1x
+            if (FfbgmGainMask & (1 << i)) channel = (channel * FfbgmGainQ8) >> 8;  // ff-bgm1x
             chan->PanOutput(channel, left, right);
         }
 
