@@ -1369,8 +1374,10 @@ static void StepRunLoop_Throttle(bool allowSleep = true, int forceFrameSkip = -1
 		}
 		if (mainLoopData.framestoskip < 1)
 			mainLoopData.framestoskip += ffSkipRate;
+		if (FastForwardSpeed > 0 && allowSleep)
