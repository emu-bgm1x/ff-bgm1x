+static void _loadBgm1xSettings(void) {
+	struct retro_variable var;
+	bool enabled = true;
+	bool ffCutscenes = false;
+	bool sfx1x = true;
+	int sfxVolume = 0x100;
+
+	var.key = "mgba_ff_bgm1x";
+	var.value = 0;
+	if (environCallback(RETRO_ENVIRONMENT_GET_VARIABLE, &var) && var.value) {
+		enabled = strcmp(var.value, "disabled") != 0;
+	}
+	var.key = "mgba_ff_bgm1x_cutscenes";
+	var.value = 0;
+	if (environCallback(RETRO_ENVIRONMENT_GET_VARIABLE, &var) && var.value) {
+		ffCutscenes = strcmp(var.value, "enabled") == 0;
+	}
+	var.key = "mgba_ff_bgm1x_sfx";
+	var.value = 0;
+	if (environCallback(RETRO_ENVIRONMENT_GET_VARIABLE, &var) && var.value) {
+		sfx1x = strcmp(var.value, "disabled") != 0;
+	}
+	var.key = "mgba_ff_bgm1x_sfx_volume";
+	var.value = 0;
+	if (environCallback(RETRO_ENVIRONMENT_GET_VARIABLE, &var) && var.value) {
+		sfxVolume = (strtol(var.value, NULL, 10) * 0x100) / 100;
+	}
+	ffBgm1xSetOptions(enabled, ffCutscenes, sfx1x, sfxVolume);
+}
