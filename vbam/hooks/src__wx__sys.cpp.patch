 }
@@ -1248,8 +1257,14 @@ void systemOnWriteDataToSoundBuffer(const uint16_t* finalWave, int length)
 #ifndef NO_FFMPEG
     GameArea* panel = wxGetApp().frame->GetPanel();
 
-    if (panel)
-        panel->AddFrame(finalWave, length);
+    if (panel && panel->IsRecording()) {
+        // ff-bgm1x: add the 1x-speed sound to the recording (the sound sent to the driver is unchanged)
+        static std::vector<uint16_t> mixed;
+        const int frames = length / 4;
+        mixed.assign(finalWave, finalWave + frames * 2);
