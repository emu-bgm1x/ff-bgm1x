--- a/src/wx/sys.cpp
+++ b/src/wx/sys.cpp
@@ -1,6 +1,9 @@
 #include <algorithm>
+#include <vector>
 
 #include <wx/ffile.h>
+
+#include "wx/ffbgm/vbam_bgm.h"
 #include <wx/generic/prntdlgg.h>
 #include <wx/print.h>
 #include <wx/printdlg.h>
@@ -392,6 +395,10 @@ uint32_t systemReadJoypad(int joy)
     ret &= ~((ret & (KEYM_LEFT | KEYM_DOWN | KEYM_MOTION_DOWN | KEYM_MOTION_RIGHT)) >> 1);
     ret &= REALKEY_MASK;
 
+    // ff-bgm1x: ignore the speed button while a cutscene song plays ("fast forward during cutscenes" off)
+    if (ffbgm::SpeedHold())
+        ret &= ~KEYM_SPEED;
+
     if (game_recording) {
         uint32_t rret = ret & ~(KEYM_SPEED | KEYM_CAPTURE);
 
@@ -549,6 +556,8 @@ void system10Frames() {
 
 void systemFrame()
 {
