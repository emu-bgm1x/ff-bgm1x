+        private fun customButtonBitmap(size: Int, label: String, pressed: Boolean): Bitmap {
+            val bitmap = Bitmap.createBitmap(max(size, 1), max(size, 1), Bitmap.Config.ARGB_8888)
+            val canvas = Canvas(bitmap)
+            val r = size / 2f
+            val paint = Paint(Paint.ANTI_ALIAS_FLAG)
+            paint.color = if (pressed) 0x80151515.toInt() else 0x80EAEAEA.toInt()
+            canvas.drawCircle(r, r, r, paint)
+            paint.color = if (pressed) 0xBFFFFFFF.toInt() else 0xBF000000.toInt()
+            paint.typeface = android.graphics.Typeface.DEFAULT_BOLD
+            paint.textAlign = Paint.Align.CENTER
+            val maxW = size * 0.62f
+            fun fit(text: String, start: Float): Float {
+                paint.textSize = start
+                val w = paint.measureText(text)
+                return if (w > maxW) start * maxW / w else start
+            }
+            val one = fit(label, size * 0.26f)
+            val space = label.indexOf(' ')
+            if (one < size * 0.17f && space > 0) {
