+            var scale = CUSTOM_BUTTON_SCALE
+            scale *= (preferences.getInt("controlScale", 50) + 50).toFloat() / 100f
+            scale *= (preferences.getInt("controlScale-$id", 50) + 50).toFloat() / 100f
+            val size = (min(dm.widthPixels, dm.heightPixels) * scale).toInt()
+            val label = context.getString(function.labelRes)
+            val opacity: Int = preferences.getInt("controlOpacity", 50) * 255 / 100
+            val overlayDrawable = InputOverlayDrawableButton(
+                context.resources,
+                customButtonBitmap(size, label, false),
+                customButtonBitmap(size, label, true),
+                id,
+                opacity
+            )
+            // 자리가 없으면 화면 가운데
+            val x = preferences.getFloat("$id$orientation-X", ((dm.widthPixels - size) / 2).toFloat()).toInt()
+            val y = preferences.getFloat("$id$orientation-Y", ((dm.heightPixels - size) / 2).toFloat()).toInt()
+            overlayDrawable.setBounds(x, y, x + size, y + size)
+            overlayDrawable.setPosition(x, y)
+            return overlayDrawable
+        }
