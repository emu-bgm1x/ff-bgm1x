+    fun customLayout(portrait: Boolean): Pair<IntArray, IntArray> {
+        val s = customLayoutSettings(portrait)
+        return intArrayOf(s[0].int, s[1].int, s[2].int, s[3].int) to
+            intArrayOf(s[4].int, s[5].int, s[6].int, s[7].int)
