+        private fun customButtonBitmap(size: Int, label: String, pressed: Boolean): Bitmap {
+            val bitmap = Bitmap.createBitmap(max(size, 1), max(size, 1), Bitmap.Config.ARGB_8888)
+            val canvas = Canvas(bitmap)
+            val r = size / 2f
+            val paint = Paint(Paint.ANTI_ALIAS_FLAG)
+            paint.color = if (pressed) 0xFFB0B0B0.toInt() else 0xFF5A5A5A.toInt()
+            canvas.drawCircle(r, r, r * 0.95f, paint)
+            paint.style = Paint.Style.STROKE
+            paint.strokeWidth = size * 0.04f
+            paint.color = 0xFFE0E0E0.toInt()
+            canvas.drawCircle(r, r, r * 0.92f, paint)
+            paint.style = Paint.Style.FILL
+            paint.color = Color.WHITE
+            paint.textAlign = Paint.Align.CENTER
+            var textSize = size * 0.3f
+            paint.textSize = textSize
+            val maxW = size * 0.8f
+            val w = paint.measureText(label)
+            if (w > maxW) {
+                textSize *= maxW / w
+                paint.textSize = textSize
+            }
+            canvas.drawText(label, r, r + textSize / 3f, paint)
+            return bitmap
+        }
+
