+        NativeLibrary.reloadSettings()
+        val state = getString(if (setting.boolean) R.string.ff_func_state_on else R.string.ff_func_state_off)
+        Toast.makeText(requireContext(), "${getString(nameRes)}: $state", Toast.LENGTH_SHORT).show()
+    }
