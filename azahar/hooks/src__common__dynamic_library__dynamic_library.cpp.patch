+void* DynamicLibrary::SelfHandle() {
+#if defined(_WIN32)
+    // GetModuleHandleExW without flags adds a reference, so the FreeLibrary in the destructor is balanced
+    HMODULE self = nullptr;
+    if (!GetModuleHandleExW(0, nullptr, &self)) {
+        return nullptr;
+    }
+    return reinterpret_cast<void*>(self);
+#else
+    return dlopen(nullptr, RTLD_LAZY);
+#endif
+}
