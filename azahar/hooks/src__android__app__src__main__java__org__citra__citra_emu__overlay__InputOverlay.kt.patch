+        private const val CUSTOM_BUTTON_SCALE = 0.11f
+
+        // ff-bgm1x: 기능 이름을 쓴 동그란 버튼 그림 (글자는 동그라미 안에 들어가게 줄인다)
+        private fun customButtonBitmap(size: Int, label: String, pressed: Boolean): Bitmap {
+            val bitmap = Bitmap.createBitmap(max(size, 1), max(size, 1), Bitmap.Config.ARGB_8888)
+            val canvas = Canvas(bitmap)
+            val r = size / 2f
+            val paint = Paint(Paint.ANTI_ALIAS_FLAG)
+            paint.color = if (pressed) 0xFFB0B0B0.toInt() else 0xFF5A5A5A.toInt()
+            canvas.drawCircle(r, r, r * 0.95f, paint)
+            paint.style = Paint.Style.STROKE
+            paint.strokeWidth = size * 0.04f
+            paint.color = 0xFFE0E0E0.toInt()
+            canvas.drawCircle(r, r, r * 0.92f, paint)
+            paint.style = Paint.Style.FILL
+            paint.color = Color.WHITE
+            paint.textAlign = Paint.Align.CENTER
+            var textSize = size * 0.3f
+            paint.textSize = textSize
+            val maxW = size * 0.8f
+            val w = paint.measureText(label)
+            if (w > maxW) {
+                textSize *= maxW / w
+                paint.textSize = textSize
+            }
+            canvas.drawText(label, r, r + textSize / 3f, paint)
+            return bitmap
+        }
+
+        private fun initializeCustomButton(
+            context: Context,
+            id: Int,
+            function: FfCustomButtons.Function,
+            orientation: String
+        ): InputOverlayDrawableButton {
+            val dm = context.resources.displayMetrics
+            var scale = CUSTOM_BUTTON_SCALE
+            scale *= (preferences.getInt("controlScale", 50) + 50).toFloat() / 100f
+            scale *= (preferences.getInt("controlScale-$id", 50) + 50).toFloat() / 100f
+            val size = (min(dm.widthPixels, dm.heightPixels) * scale).toInt()
+            val label = context.getString(function.labelRes)
+            val opacity: Int = preferences.getInt("controlOpacity", 50) * 255 / 100
+            val overlayDrawable = InputOverlayDrawableButton(
+                context.resources,
+                customButtonBitmap(size, label, false),
+                customButtonBitmap(size, label, true),
+                id,
+                opacity
+            )
+            // 자리가 없으면 화면 가운데
+            val x = preferences.getFloat("$id$orientation-X", ((dm.widthPixels - size) / 2).toFloat()).toInt()
+            val y = preferences.getFloat("$id$orientation-Y", ((dm.heightPixels - size) / 2).toFloat()).toInt()
+            overlayDrawable.setBounds(x, y, x + size, y + size)
+            overlayDrawable.setPosition(x, y)
+            return overlayDrawable
+        }
