 namespace DynamicLibrary::FFmpeg {
 
+// ff-bgm1x: in the static build (FFBGM_STATIC_FFMPEG) FFmpeg is linked into the exe and its functions
+// are exported from it, so they are looked up in the exe itself instead of avcodec-60.dll etc.
+static std::unique_ptr<Common::DynamicLibrary> OpenLibrary(std::string_view name, int major) {
+#ifdef FFBGM_STATIC_FFMPEG
+    (void)name;
+    (void)major;
+    return std::make_unique<Common::DynamicLibrary>(Common::DynamicLibrary::SelfHandle());
+#else
+    return std::make_unique<Common::DynamicLibrary>(name, major);
+#endif
+}
