+                val sy = variant.uiSize.y.toFloat() / imageSize.second
+                fun map(r: android.graphics.Rect) = Rect(
+                    (r.left * sx).toInt(), (r.top * sy).toInt(), (r.width() * sx).toInt(), (r.height() * sy).toInt(),
+                )
+                val top = map(screens[0])
